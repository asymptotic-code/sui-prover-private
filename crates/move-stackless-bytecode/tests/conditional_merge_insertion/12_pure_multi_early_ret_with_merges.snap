     var $t11: bool
     var $t12: u64
     var $t13: u64
     var $t14: bool
     var $t15: bool
  0: $t4 := 0
  1: $t5 := ==($t0, $t4)
  2: if ($t5) goto 3 else goto 6
  3: label L1
  4: $t6 := true
  5: nop
  6: label L0
  7: $t7 := 0
  8: $t8 := ==($t1, $t7)
  9: if ($t8) goto 10 else goto 13
 10: label L3
 11: $t9 := true
