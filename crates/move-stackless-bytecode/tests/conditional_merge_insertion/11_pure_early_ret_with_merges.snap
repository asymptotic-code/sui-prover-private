public fun test::classify($t0|x: u64, $t1|y: u64): bool {
     var $t2|acc#1#0: u64
     var $t3: u64
     var $t4: bool
     var $t5: bool
     var $t6: u64
     var $t7: bool
     var $t8: u64
     var $t9: bool
     var $t10: u64
     var $t11: u64
     var $t12: bool
  0: $t3 := 0
  1: $t4 := ==($t0, $t3)
  2: if ($t4) goto 3 else goto 6
  3: label L1
  4: $t5 := true
  5: goto 17
  6: label L0
  7: $t10 := $t1
  8: $t6 := 100
  9: $t7 := >($t1, $t6)
 10: if ($t7) goto 11 else goto 14
 11: label L3
 12: $t8 := 100
 13: $t11 := -($t1, $t8)
 14: label L2
     # conditional_merge_insertion: t2 := if_then_else(t7, t11, t10)
 15: $t2 := if_then_else($t7, $t11, $t10)
 16: $t9 := >($t2, $t0)
 17: label L4
     # conditional_merge_insertion: t12 := if_then_else(t4, t5, t9)
